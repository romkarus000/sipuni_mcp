# Sipuni API
SIPUNI_USER=012345
SIPUNI_SECRET=your_sipuni_api_key_secret

# CRM DB (optional)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=readonly
# DB_PASSWORD=
# DB_NAME=lk

# Pachca bot
PACHCA_TOKEN=
PACHCA_BOT_USER_ID=
PACHCA_CHAT_ID=
# In Pachca: Bot settings -> Outgoing Webhook -> Signing secret
PACHCA_WEBHOOK_SECRET=

TIME_ZONE=Europe/Moscow

# Optional Bearer token for POST /v1/gateway (n8n → Sipuni). If empty, gateway is open inside Docker network only.
MCP_GATEWAY_TOKEN=
